# Application
PROJECT_NAME="FastAPI Backend Services"
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=30
VALID_API_KEYS=["dev-api-key-change-in-production"]

# AI Provider: "mock" or "openai"
AI_PROVIDER=mock
OPENAI_API_KEY=

# Teradata
TERADATA_HOST=
TERADATA_USERNAME=
TERADATA_PASSWORD=
TERADATA_DATABASE=

# IBM DB2
DB2_HOST=
DB2_PORT=50000
DB2_DATABASE=
DB2_USERNAME=
DB2_PASSWORD=

# SQL Server
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=
SQLSERVER_USERNAME=
SQLSERVER_PASSWORD=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
